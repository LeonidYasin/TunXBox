<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#FF24374E" /><corners android:radius="16dp" /><stroke android:width="3dp" android:color="#FF67E8F9" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#FF172F46" /><corners android:radius="16dp" /><stroke android:width="2dp" android:color="#FF38BDF8" /></shape>
    </item>
    <item><shape><solid android:color="#FF1E293B" /><corners android:radius="16dp" /></shape></item>
</selector>
