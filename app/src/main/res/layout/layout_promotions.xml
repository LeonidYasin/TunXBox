<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <include layout="@layout/layout_appbar" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/promotions_title" android:textAppearance="?attr/textAppearanceHeadline6" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/promotions_body" android:textSize="16sp" android:textColor="?android:textColorSecondary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/promotions_project" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:minHeight="48dp" android:focusable="true" android:text="@string/project_source_tunxbox" />
            <com.google.android.material.button.MaterialButton android:id="@+id/promotions_issues" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:focusable="true" android:text="@string/project_report_issue" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
