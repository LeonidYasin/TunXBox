<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <include layout="@layout/layout_appbar" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/lan_explanation" android:textSize="18sp" />
            <TextView android:id="@+id/lan_scope" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="18sp" android:textIsSelectable="true" />
            <Button android:id="@+id/lan_network" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/lan_refresh" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/lan_ports" android:text="@string/lan_ports_label" android:textSize="18sp" />
            <EditText android:id="@+id/lan_ports" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textNoSuggestions" android:singleLine="true" android:maxLength="47" android:text="1080,8080,8118,7890" android:textSize="18sp" />
            <CheckBox android:id="@+id/lan_consent" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:saveEnabled="false" android:text="@string/lan_consent" android:textSize="18sp" />
            <Button android:id="@+id/lan_scan" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/lan_scan" android:enabled="false" />
            <Button android:id="@+id/lan_cancel" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@android:string/cancel" android:visibility="gone" />
            <TextView android:id="@+id/lan_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:accessibilityLiveRegion="polite" android:text="@string/lan_idle" android:textSize="18sp" />
            <LinearLayout android:id="@+id/lan_results" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
