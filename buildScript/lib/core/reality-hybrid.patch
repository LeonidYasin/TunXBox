 func (c *realityClientConnWrapper) WriterReplaceable() bool {
 	return true
 }
+
+// Prefer the ordinary X25519 share when present; otherwise use the X25519
+// component of the hybrid share. Never skip REALITY certificate authentication.
+func realityClientECDHEKey(primary, hybrid *ecdh.PrivateKey) *ecdh.PrivateKey {
+	if primary != nil {
+		return primary
+	}
+	return hybrid
+}
+
+// Only REALITY uses this compatibility extension. Other TLS profiles are unchanged.
+// Authentication/certificate validation remains mandatory. Each caller owns its spec.
+func realityClientHybridSpec(spec *utls.ClientHelloSpec) error {
+	var curves *utls.SupportedCurvesExtension
+	var shares *utls.KeyShareExtension
+	for _, extension := range spec.Extensions {
+		switch typed := extension.(type) {
+		case *utls.SupportedCurvesExtension:
+			curves = typed
+		case *utls.KeyShareExtension:
+			shares = typed
+		}
+	}
+	if curves == nil || shares == nil {
+		return E.New("reality TLS preset requires supported groups and key shares")
+	}
+	groups := []utls.CurveID{utls.X25519MLKEM768}
+	for _, group := range curves.Curves {
+		if group != utls.X25519MLKEM768 {
+			groups = append(groups, group)
+		}
+	}
+	curves.Curves = groups
+	keys := []utls.KeyShare{{Group: utls.X25519MLKEM768}}
+	for _, share := range shares.KeyShares {
+		if share.Group != utls.X25519MLKEM768 {
+			keys = append(keys, share)
+		}
+	}
+	shares.KeyShares = keys
+	return nil
+}
