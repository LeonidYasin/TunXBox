@@ -0,0 +1,79 @@
+//go:build with_utls
+
+package tls
+
+import (
+	"crypto/ecdh"
+	"crypto/rand"
+	utls "github.com/metacubex/utls"
+	"reflect"
+	"testing"
+)
+
+func TestRealityClientECDHEKeySelection(t *testing.T) {
+	primary, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	hybrid, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name                  string
+		primary, hybrid, want *ecdh.PrivateKey
+	}{
+		{"both-prefer-primary", primary, hybrid, primary},
+		{"primary-only", primary, nil, primary},
+		{"hybrid-only", nil, hybrid, hybrid},
+		{"neither-fails-closed", nil, nil, nil},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := realityClientECDHEKey(tc.primary, tc.hybrid); got != tc.want {
+				t.Fatal("wrong key selected")
+			}
+		})
+	}
+}
+
+func TestRealityHybridBrowserPresets(t *testing.T) {
+	for _, id := range []utls.ClientHelloID{utls.HelloFirefox_Auto, utls.HelloChrome_Auto, utls.HelloEdge_Auto, utls.HelloSafari_Auto} {
+		t.Run(id.Str(), func(t *testing.T) {
+			spec, err := utls.UTLSIdToSpec(id)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ciphers := append([]uint16(nil), spec.CipherSuites...)
+			if err = realityClientHybridSpec(&spec); err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(ciphers, spec.CipherSuites) {
+				t.Fatal("cipher suites changed")
+			}
+			if err = realityClientHybridSpec(&spec); err != nil {
+				t.Fatal(err)
+			}
+			for _, ext := range spec.Extensions {
+				if keys, ok := ext.(*utls.KeyShareExtension); ok {
+					count := 0
+					for _, key := range keys.KeyShares {
+						if key.Group == utls.X25519MLKEM768 {
+							count++
+						}
+					}
+					if count != 1 || keys.KeyShares[0].Group != utls.X25519MLKEM768 {
+						t.Fatal("hybrid share missing, duplicated or unordered")
+					}
+				}
+			}
+		})
+	}
+}
+
+func TestRealityHybridRejectsIncompletePreset(t *testing.T) {
+	for _, spec := range []utls.ClientHelloSpec{{}, {Extensions: []utls.TLSExtension{&utls.SupportedCurvesExtension{}}}, {Extensions: []utls.TLSExtension{&utls.KeyShareExtension{}}}} {
+		if realityClientHybridSpec(&spec) == nil {
+			t.Fatal("incomplete TLS preset accepted")
+		}
+	}
+}
