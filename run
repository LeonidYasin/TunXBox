#!/bin/bash

EXEC=""
TARGET="buildScript"
declare -A PARAMS
declare -i INDEX=0

for e in $@; do
  TARGET="$TARGET/$e"
  PARAMS[$INDEX]=$e
  INDEX=$INDEX+1
  shift
  if [ -f "${TARGET}.sh" ]; then
    EXEC="${TARGET}.sh"
    PARAMS=()
    INDEX=0
  fi
done

echo ">> $EXEC"
[[ -n "$EXEC" ]] || { echo "Unknown build command" >&2; exit 2; }
exec bash "$EXEC" "${PARAMS[@]}"
